SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Shipping provider — SuperFrete
SUPERFRETE_TOKEN=
SUPERFRETE_ENV=production
SUPERFRETE_USER_AGENT=Koda/1.0 (shipping@your-domain.example)
# Optional comma-separated services. Default: PAC, SEDEX, Mini Envios, Jadlog and J&T.
SUPERFRETE_SERVICES=1,2,17,3,33
KODA_ORIGIN_POSTAL_CODE=
# Optional: if omitted, the server derives the quote-signing key from its service-role secret.
KODA_SHIPPING_SIGNING_SECRET=
